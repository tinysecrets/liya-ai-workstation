# LIYA / RIYA - Neural OS Setup Guide

# 🧠 Core Identity
VITE_USER_NAME=Master
VITE_APP_NAME=LIYA

# ☁️ AI Engines (At least one required)
VITE_OLLAMA_CLOUD_API_KEY=your_ollama_key_here

# 💾 Memory (Optional - Defaults to local IndexedDB)
VITE_MEM0_API_KEY=your_mem0_key_here
VITE_MEM0_API_URL=https://api.mem0.ai/v1

# 🌍 Search & Knowledge (Optional)
VITE_NEWS_API_KEY=your_news_key_here
VITE_WEATHER_API_KEY=your_weather_key_here
VITE_PEXELS_API_KEY=your_pexels_key_here

# 🏠 Home Automation (Optional - Sinric Pro)
VITE_SINRIC_API_KEY=your_sinric_key_here
VITE_SINRIC_APP_SECRET=your_sinric_secret_here
VITE_SINRIC_DEVICE_PANEL_LIGHT=id_here
VITE_SINRIC_DEVICE_STAR_LIGHT=id_here
VITE_SINRIC_DEVICE_TV=id_here

# ⚙️ System Settings
VITE_BACKEND_URL=http://localhost:3000
VISION_MODEL=qwen3-vl:235b-cloud
VITE_VISION_MODEL=qwen3-vl:235b-cloud
